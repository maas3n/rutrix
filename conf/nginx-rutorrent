server {
    listen 80;
    listen [::]:80;
    server_name <server ip>;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <server ip>;

    root /var/www;
    index index.php index.html;
    client_max_body_size 40m;

    ssl_certificate /etc/nginx/ssl/rutorrent.crt;
    ssl_certificate_key /etc/nginx/ssl/rutorrent.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:RutorrentSSL:10m;

    location = / {
        return 302 /rutorrent/;
    }

    location = /rutorrent {
        return 301 /rutorrent/;
    }

    location ^~ /rutorrent/conf/ {
        deny all;
    }

    location ^~ /rutorrent/share/ {
        deny all;
    }

    location /rutorrent/ {
        auth_basic "ruTorrent";
        auth_basic_user_file /etc/nginx/.htpasswd-rutorrent;
        try_files $uri $uri/ =404;
    }

    location ~ ^/rutorrent/.+\.php$ {
        auth_basic "ruTorrent";
        auth_basic_user_file /etc/nginx/.htpasswd-rutorrent;
        include snippets/fastcgi-php.conf;
        fastcgi_param REMOTE_USER $remote_user;
        fastcgi_pass unix:<php socket>;
        fastcgi_read_timeout 300;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        return 404;
    }
}
