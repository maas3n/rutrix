# Managed by rutrix
[Unit]
Description=rTorrent for <user name>
Documentation=https://github.com/rakshasa/rtorrent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user name>
Group=<user name>
SupplementaryGroups=rutorrent
WorkingDirectory=<user home>
Environment=HOME=<user home>
UMask=0007
LimitNOFILE=32768
ExecStartPre=-/bin/rm -f <user home>/rtorrent/.session/rtorrent.lock
ExecStart=/usr/local/bin/rtorrent -n -o import=<user home>/.rtorrent.rc
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
